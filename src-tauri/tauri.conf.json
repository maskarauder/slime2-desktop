{
	"build": {
		"beforeDevCommand": "npm run before:dev",
		"beforeBuildCommand": "npm run before:build",
		"frontendDist": "../dist",
		"devUrl": "http://localhost:57142"
	},
	"bundle": {
		"active": true,
		"resources": {
			"../LICENSE": "LICENSE",
			"../COPYING": "COPYING",
			"../NOTICE.md": "NOTICE.md",
			"../resources/overlay_server": "overlay_server/",
			"../resources/widgets": "widgets/",
			"../resources/assets": "assets/"
		},
		"category": "utility",
		"shortDescription": "Slippy2 Desktop: an independent Slime2 fork",
		"longDescription": "Manage local stream widgets with an independent fork maintained by Maskarauder. Not affiliated with, supported by, or endorsed by the upstream Slime2 project.",
		"homepage": "https://github.com/maskarauder/slime2-desktop",
		"publisher": "Maskarauder",
		"windows": {
			"wix": {
				"upgradeCode": "f8922db7-c2f9-5ee4-9fa1-206acc0a85bf"
			}
		},
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"targets": ["appimage", "deb", "rpm", "msi", "app", "dmg"],
		"linux": {
			"deb": {
				"provides": ["slime2"],
				"replaces": ["slime2"],
				"conflicts": ["slime2"]
			},
			"rpm": {
				"provides": ["slime2"],
				"obsoletes": ["slime2"]
			},
			"appimage": {
				"bundleMediaFramework": true
			}
		}
	},
	"productName": "Slippy2 Desktop",
	"mainBinaryName": "Slime2",
	"version": "../package.json",
	"identifier": "stream.slime2.desktop",
	"plugins": {
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM4ODRGMTk5Rjg4NTNBMjcKUldRbk9vWDRtZkdFeUI3VTFjVFcxMHRCR1U4OWZ6SUJjL0IwV1JJSHNWVEpzaDFmcVp2aTN2ZVMK",
			"windows": {
				"installMode": "passive"
			}
		}
	},
	"app": {
		"windows": [
			{
				"title": "Slippy2 Desktop",
				"width": 1200,
				"height": 700,
				"minWidth": 1200,
				"minHeight": 700,
				"center": true,
				"acceptFirstMouse": true,
				"backgroundThrottling": "disabled",
				"generalAutofillEnabled": false
			}
		],
		"security": {
			"capabilities": [
				"dialog",
				"clipboard",
				"path",
				"event",
				"version",
				"opener",
				"log",
				"window-state"
			],
			"csp": {
				"default-src": ["'self'", "http://localhost:*"],
				"connect-src": [
					"ipc:",
					"http://ipc.localhost",
					"https://id.twitch.tv",
					"https://api.twitch.tv",
					"https://api.github.com",
					"wss://eventsub.wss.twitch.tv",
					"https://www.googleapis.com",
					"https://api.pronouns.alejo.io",
					"https://pronoundb.org",
					"https://api.betterttv.net",
					"https://api.frankerfacez.com",
					"https://7tv.io",
					"wss://events.7tv.io",
					"https://pluralmind.chat"
				],
				"style-src": ["'self'", "https://fonts.googleapis.com"],
				"font-src": ["https://fonts.gstatic.com"],
				"img-src": ["'self'", "http://localhost:*", "https:", "data:"],
				"worker-src": ["'self'", "http://localhost:*", "blob:"],
				"script-src-elem": ["'self'", "http://localhost:*"]
			}
		}
	}
}
